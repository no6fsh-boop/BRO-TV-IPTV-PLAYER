<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Live TV, EPG, VOD streaming over the network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Needed so the phone can reach the embedded pairing server on the TV's LAN IP -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- This is a TV-first app: no touchscreen required, leanback launcher entry point -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".BroTvApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.BroTV"
        android:usesCleartextTraffic="true">
        <!--
          usesCleartextTraffic=true is required because:
          1) many IPTV providers only expose plain-http Xtream/M3U endpoints, and
          2) the phone-pairing handshake is a plain-http server on the local LAN.
          Tighten this with a network_security_config allow-list scoped to the
          user's configured host + local subnet before shipping to production.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.BroTV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LEANBACK_LAUNCHER, not just LAUNCHER, so the BRO TV banner
                     shows up correctly in the Android TV / Google TV row-based
                     home screen launcher with the gold identity, not a red icon. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Embedded pairing server + player run in-process; no extra services
             declared yet in the scaffold. Add a foreground Service here if
             background live-TV playback (PiP) is required later. -->
    </application>
</manifest>
